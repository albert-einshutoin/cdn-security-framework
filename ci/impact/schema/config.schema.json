{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "maxParallel",
    "rollout",
    "supportedManifests",
    "safePathPatterns",
    "riskRules",
    "modules",
    "commands",
    "testMappings",
    "smokeTargetIds",
    "fullTargetId"
  ],
  "properties": {
    "version": { "const": 1 },
    "maxParallel": { "type": "integer", "minimum": 1, "maximum": 4 },
    "rollout": {
      "type": "object",
      "required": ["mode", "minimumDays"],
      "properties": {
        "mode": { "enum": ["shadow", "selective"] },
        "minimumDays": { "type": "integer", "minimum": 14 }
      },
      "additionalProperties": false
    },
    "supportedManifests": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "safePathPatterns": { "$ref": "#/definitions/stringArray" },
    "riskRules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/riskRule" }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/definitions/moduleRule" }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/command" }
    },
    "testMappings": {
      "type": "array",
      "items": { "$ref": "#/definitions/testMapping" }
    },
    "smokeTargetIds": { "$ref": "#/definitions/stringArray" },
    "fullTargetId": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "definitions": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "riskRule": {
      "type": "object",
      "required": ["id", "patterns", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "patterns": { "$ref": "#/definitions/stringArray" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "moduleRule": {
      "type": "object",
      "required": ["id", "patterns", "dependsOn"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "patterns": { "$ref": "#/definitions/stringArray" },
        "dependsOn": { "$ref": "#/definitions/stringArray" }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["id", "category", "command", "args"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "enum": ["static", "build", "unit", "integration", "e2e", "smoke", "full"] },
        "command": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._+-]+$" },
        "args": { "type": "array", "items": { "type": "string" } },
        "resourceLocks": { "$ref": "#/definitions/stringArray" },
        "always": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "testMapping": {
      "type": "object",
      "required": ["id", "patterns", "targetIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "patterns": { "$ref": "#/definitions/stringArray" },
        "modules": { "$ref": "#/definitions/stringArray" },
        "targetIds": { "$ref": "#/definitions/stringArray" }
      },
      "additionalProperties": false
    }
  }
}
