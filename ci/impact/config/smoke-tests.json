[
  {
    "id": "diff-check",
    "category": "static",
    "command": "git",
    "args": ["diff", "--check", "{baseRevision}", "{headRevision}"],
    "always": true
  },
  {
    "id": "dependency-audit",
    "category": "static",
    "command": "npm",
    "args": ["audit", "--audit-level=high"],
    "always": true
  },
  {
    "id": "typecheck",
    "category": "static",
    "command": "npm",
    "args": ["run", "typecheck"],
    "always": true
  },
  {
    "id": "policy-lint",
    "category": "static",
    "command": "npm",
    "args": ["run", "lint:policy:ci"],
    "always": true,
    "resourceLocks": ["build-output"]
  },
  {
    "id": "build",
    "category": "build",
    "command": "npm",
    "args": ["run", "build:test-fixtures"],
    "always": true,
    "resourceLocks": ["build-output"]
  },
  {
    "id": "impact-smoke",
    "category": "smoke",
    "command": "node",
    "args": ["scripts/impact-smoke-tests.js"],
    "resourceLocks": ["build-output"]
  },
