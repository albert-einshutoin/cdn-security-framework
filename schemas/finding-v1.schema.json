{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cdn-security-framework.dev/schemas/finding-v1.schema.json",
  "title": "Security Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ruleId",
    "instanceId",
    "severity",
    "confidence",
    "category",
    "title",
    "message",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ruleId": { "type": "string", "pattern": "^SC-[A-Z][A-Z0-9]*-[0-9]{3}$" },
    "instanceId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "severity": { "enum": ["error", "warning", "info"] },
    "confidence": { "enum": ["deterministic", "high-confidence", "heuristic"] },
    "category": {
      "enum": [
        "inventory",
        "exposure",
        "authentication",
        "authorization",
        "resource-limit",
        "misconfiguration",
        "governance",
        "runtime-evidence"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "route": { "$ref": "#/definitions/route" },
    "expected": true,
    "actual": true,
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence" }
    },
    "remediation": { "$ref": "#/definitions/remediation" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "definitions": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "operationId": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "uri", "digest", "analyzer", "capability", "complete"],
      "properties": {
        "source": {
          "enum": ["openapi", "source-ast", "policy", "runtime", "generated-artifact"]
        },
        "uri": { "type": "string", "minLength": 1 },
        "pointer": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "analyzer": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "complete": { "type": "boolean" }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "safeAutoFix"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "safeAutoFix": { "type": "boolean" }
      }
    }
  }
}
