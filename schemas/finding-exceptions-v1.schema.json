{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cdn-security-framework.dev/schemas/finding-exceptions-v1.schema.json",
  "title": "Finding Exceptions v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "exceptions"],
  "properties": {
    "version": { "const": 1 },
    "exceptions": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/definitions/exception" }
    }
  },
  "definitions": {
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_id", "selector", "reason", "owner", "expires_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^EXC-[0-9]{4}-[A-Z0-9][A-Z0-9_-]{2,63}$" },
        "rule_id": { "type": "string", "pattern": "^SC-[A-Z][A-Z0-9]*-[0-9]{3}$" },
        "selector": { "$ref": "#/definitions/selector" },
        "reason": { "type": "string", "minLength": 20, "maxLength": 2048 },
        "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
        "expires_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "ticket": { "type": "string", "minLength": 1, "maxLength": 256 },
        "allow_broad": { "type": "boolean" },
        "broad_reason": { "type": "string", "minLength": 20, "maxLength": 2048 }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "method": { "type": "string", "minLength": 1, "maxLength": 32 },
        "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "target": { "enum": ["aws", "cloudflare"] },
        "environment": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
